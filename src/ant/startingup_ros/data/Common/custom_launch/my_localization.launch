<launch>
	<arg name="plane" default="0"/>
	<arg name="get_gnss_init_pose" default="false" />

	<arg name="init_pos_gnss" default="1" />   <!--初始化gnss位置-->
	<arg name="get_height" default="1" /><!--是否获取高度-->
	<arg name="method_type" default="0" /><!--使用类型-->
	<arg name="use_imu" default="0" /><!--是否使用IMU-->
	<arg name="use_gnss" default="1" /><!--是否使用GNSS-->

	<include file="$(find points_downsampler)/launch/points_downsample.launch">
		<arg name="node_name" value="voxel_grid_filter"/>
		<arg name="points_topic" value="/points_raw"/>
		<arg name="measurement_range" value="200" />								<!--测量最大距离-->
	</include>

	<!-- nmea2tfpose or fix2tfpose-->
	<include file="$(find gnss_localizer)/launch/fix2tfpose.launch">
		<arg name="plane" value="$(arg plane)"/>
		<arg name="get_gnss_init_pose" value="$(arg get_gnss_init_pose)"/>
	</include>

	<include file="$(find startingup_ros)/data/Common/custom_launch/encap_launch/ndt_matching.launch">
		<arg name="init_pos_gnss" value="$(arg init_pos_gnss)" />   <!--初始化gnss位置-->
		<arg name="get_height" value="$(arg get_height)" /><!--是否获取高度-->
		<arg name="method_type" value="$(arg method_type)" /><!--使用类型-->
		<arg name="use_imu" value="$(arg use_imu)" /><!--是否使用IMU-->
		<arg name="use_gnss" value="$(arg use_gnss)" /><!--是否使用GNSS-->
	</include>

</launch>
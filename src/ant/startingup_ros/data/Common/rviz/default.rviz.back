Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Map1/Points Map1
        - /Sensing1
        - /Sensing1/Points Raw1
        - /Planning1/局部行驶那一条车道1/Namespaces1
        - /Planning1/局部行驶车道高亮1/Namespaces1
